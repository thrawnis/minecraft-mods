+/// Walk-in buildings: a ladder from the ground floor up through every storey slab of an
+/// empty building, against a wall column made solid behind it (a ladder can't hang on a
+/// glass pane), so each floor can be reached on foot. Kept away from the doorways.
+fn generate_access_ladder(
+    editor: &mut WorldEditor,
+    floor_area: &[(i32, i32)],
+    wall_outline: &[(i32, i32)],
+    config: &BuildingConfig,
+    passages: &CoordinateBitmap,
+    entrances: &[EntrancePlan],
+) {
+    if config.floor_cycle <= 0 || config.building_height <= config.floor_cycle {
+        return;
+    }
+    let start = config.start_y_offset;
+    let top = start + config.building_height;
+    // The same storey slabs `generate_floors_and_ceilings` lays.
+    let Some(top_floor) = (start + config.grammar_anchor() + config.floor_cycle..top)
+        .step_by(config.floor_cycle as usize)
+        .last()
+    else {
+        return;
+    };
+    let floor: FnvHashSet<(i32, i32)> = floor_area.iter().copied().collect();
+    let wall: FnvHashSet<(i32, i32)> = wall_outline.iter().copied().collect();
+    let near_door = |x: i32, z: i32| {
+        entrances
+            .iter()
+            .any(|p| (p.x - x).abs() <= 2 && (p.z - z).abs() <= 2)
+    };
+    let mut best: Option<(i32, i32, i32, i32)> = None;
+    for &(x, z) in floor_area {
+        if passages.contains(x, z) || near_door(x, z) {
+            continue;
+        }
+        for (dx, dz) in [(0, -1), (1, 0), (0, 1), (-1, 0)] {
+            let (wx, wz) = (x + dx, z + dz);
+            let ok = wall.contains(&(wx, wz))
+                && !floor.contains(&(wx, wz))
+                && floor.contains(&(x - dx, z - dz))
+                && !passages.contains(wx, wz)
+                && !near_door(wx, wz)
+                && !config.is_photo_column(wx, wz);
+            if ok && best.is_none_or(|b| (x, z) < (b.0, b.1)) {
+                best = Some((x, z, dx, dz));
+            }
+        }
+    }
+    let Some((x, z, dx, dz)) = best else {
+        return;
+    };
+    let abs = config.abs_terrain_offset;
+    for y in start + 1..=top_floor + 1 {
+        editor.set_block_absolute(config.wall_block, x + dx, y + abs, z + dz, None, Some(&[]));
+    }
+    let ladder = cached_prop_block(
+        LADDER,
+        &[
+            ("facing", facing_for_normal(-dx, -dz)),
+            ("waterlogged", "false"),
+        ],
+    );
+    for y in start + 1..=top_floor {
+        editor.set_block_with_properties_absolute(ladder.clone(), x, y + abs, z, None, Some(&[]));
+    }
+}
