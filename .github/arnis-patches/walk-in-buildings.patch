+    /// Walk-in buildings: one ladder from the ground floor up through every storey slab,
+    /// with a solid block behind each rung; a one-storey building gets none.
+    #[test]
+    fn storeys_are_reached_by_one_ladder_against_a_solid_wall() {
+        // (x, z, rungs, top rung sits in a slab, headroom above it, every rung backed)
+        type Column = (i32, i32, Vec<i32>, bool, bool, bool);
+        let ladder_columns = |levels: &str| -> Vec<Column> {
+            let xz = XZBBox::rect_from_xz_lengths(60.0, 60.0).unwrap();
+            let road = bitmap_with_rect(&xz, 0, 12, 59, 14);
+            let footprints = CoordinateBitmap::new(&xz);
+            let way = rect_way(
+                43,
+                20,
+                20,
+                40,
+                32,
+                &[("building", "apartments"), ("building:levels", levels)],
+            );
+            let mut editor = test_editor(&xz);
+            run_building(&mut editor, &way, &road, &footprints);
+            let side = [(1, 0), (-1, 0), (0, 1), (0, -1)];
+            let mut found = Vec::new();
+            for x in 21..40 {
+                for z in 21..32 {
+                    let rungs: Vec<i32> = (1..80)
+                        .filter(|&y| editor.get_block_absolute(x, y, z) == Some(LADDER))
+                        .collect();
+                    let Some(&top) = rungs.last() else { continue };
+                    let in_slab = side.iter().any(|(dx, dz)| {
+                        editor
+                            .get_block_absolute(x + dx, top, z + dz)
+                            .is_some_and(|b| b != AIR && b != LADDER)
+                    });
+                    let headroom = editor
+                        .get_block_absolute(x, top + 1, z)
+                        .is_none_or(|b| b == AIR);
+                    let backed = side.iter().any(|(dx, dz)| {
+                        rungs.iter().all(|&y| {
+                            editor
+                                .get_block_absolute(x + dx, y, z + dz)
+                                .is_some_and(|b| b != AIR && !b.name().contains("pane"))
+                        })
+                    });
+                    found.push((x, z, rungs, in_slab, headroom, backed));
+                }
+            }
+            found
+        };
+
+        let none = ladder_columns("1");
+        assert!(
+            none.is_empty(),
+            "a one-storey building needs no ladder: {none:?}"
+        );
+
+        let found = ladder_columns("3");
+        assert_eq!(found.len(), 1, "exactly one ladder column: {found:?}");
+        let (_, _, rungs, in_slab, headroom, backed) = &found[0];
+        assert_eq!(rungs[0], 1, "the ladder starts on the ground floor");
+        assert!(
+            rungs.windows(2).all(|w| w[1] == w[0] + 1),
+            "the ladder has no gaps: {rungs:?}"
+        );
+        assert!(
+            *rungs.last().unwrap() >= 6,
+            "the ladder reaches the upper floors: {rungs:?}"
+        );
+        assert!(
+            *in_slab,
+            "the top rung fills a hole in the top storey's slab"
+        );
+        assert!(*headroom, "headroom above the top rung");
+        assert!(*backed, "each rung has a solid block behind it");
+    }
